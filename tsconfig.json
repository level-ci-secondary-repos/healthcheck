{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "types": ["node", "playwright"]
  },
  "include": [
    "level-ci.config.ts",
    "playwright.config.ts",
    "playwright/**/*.ts"
  ]
}
